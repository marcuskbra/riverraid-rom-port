{
  "name": "riverraid-visible-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "serve -l tcp://127.0.0.1:8080 --no-clipboard",
    "match": "node server/relay.js",
    "lint": "biome lint --error-on-warnings .",
    "check": "pnpm run lint && node --test test/*.test.js",
    "snapshot:update": "node test/snapshot.test.js --update",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "serve": "14.2.6",
    "ws": "8.18.3"
  }
}
